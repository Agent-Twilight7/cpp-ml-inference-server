{
  "uid": "inference-server",
  "title": "Inference Server",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["inference"],
  "panels": [
    {
      "type": "timeseries", "title": "Throughput (successful requests/s)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(infer_requests_total{code=\"200\"}[15s]))", "legendFormat": "req/s" }
      ]
    },
    {
      "type": "timeseries", "title": "Latency (server-side, 60 s window)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "infer_request_latency_seconds{quantile=\"0.5\"}", "legendFormat": "p50" },
        { "refId": "B", "expr": "infer_request_latency_seconds{quantile=\"0.99\"}", "legendFormat": "p99" },
        { "refId": "C", "expr": "infer_request_latency_seconds{quantile=\"0.999\"}", "legendFormat": "p99.9" }
      ]
    },
    {
      "type": "timeseries", "title": "Where the time goes (p99)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "infer_queue_wait_seconds{quantile=\"0.99\"}", "legendFormat": "queue wait p99" },
        { "refId": "B", "expr": "infer_batch_compute_seconds{quantile=\"0.99\"}", "legendFormat": "batch compute p99" }
      ]
    },
    {
      "type": "timeseries", "title": "Average batch size",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(infer_batch_size_sum[15s]) / rate(infer_batch_size_count[15s])", "legendFormat": "requests per batch" }
      ]
    },
    {
      "type": "timeseries", "title": "Queue depth and in-flight requests",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "infer_queue_depth", "legendFormat": "queue depth" },
        { "refId": "B", "expr": "infer_inflight_requests", "legendFormat": "in flight" }
      ]
    },
    {
      "type": "timeseries", "title": "Errors and rejections (per second)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (code) (rate(infer_requests_total{code!=\"200\"}[15s]))", "legendFormat": "HTTP {{code}}" }
      ]
    },
    {
      "type": "stat", "title": "Request pool blocks in use / capacity",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "infer_request_pool_blocks_in_use", "legendFormat": "in use" },
        { "refId": "B", "expr": "infer_request_pool_blocks_high_watermark", "legendFormat": "high watermark" },
        { "refId": "C", "expr": "infer_request_pool_blocks_capacity", "legendFormat": "capacity" }
      ]
    },
    {
      "type": "stat", "title": "Open connections",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "infer_connections_active", "legendFormat": "connections" } ]
    },
    {
      "type": "stat", "title": "Padding waste (share of GPU rows)",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(infer_padded_slots_total[1m]) / (rate(infer_padded_slots_total[1m]) + rate(infer_batch_size_sum[1m]))", "legendFormat": "padding" }
      ]
    }
  ]
}
